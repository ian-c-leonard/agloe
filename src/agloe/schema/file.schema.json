{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File",
  "description": "One TRIP in the Agloe format. Terms in capitals are defined in spec/vocabulary.md. spec/rules.md says what each part means.",
  "type": "object",
  "additionalProperties": false,
  "required": ["persons", "places", "options", "ways", "wants", "facts", "decisions"],
  "properties": {
    "persons": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "options": {
      "type": "array",
      "items": { "oneOf": [{ "$ref": "#/$defs/option_at_a_place" }, { "$ref": "#/$defs/option_between_places" }] }
    },
    "ways": {
      "type": "array",
      "items": { "oneOf": [{ "$ref": "#/$defs/way_one_way" }, { "$ref": "#/$defs/way_both_ways" }] }
    },
    "wants": { "type": "array", "items": { "$ref": "#/$defs/want" } },
    "facts": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/fixed_start" },
          { "$ref": "#/$defs/free_start" },
          { "$ref": "#/$defs/exact_duration" },
          { "$ref": "#/$defs/contingent_duration" },
          { "$ref": "#/$defs/access_cutoff" },
          { "$ref": "#/$defs/way_duration" },
          { "$ref": "#/$defs/way_contingent_duration" },
          { "$ref": "#/$defs/complete_set" },
          { "$ref": "#/$defs/satisfies" },
          { "$ref": "#/$defs/complete_for_a_want" },
          { "$ref": "#/$defs/starts_from" },
          { "$ref": "#/$defs/needs_right" },
          { "$ref": "#/$defs/booking" },
          { "$ref": "#/$defs/complete_rights" }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/lock" },
          { "$ref": "#/$defs/trip_start" },
          { "$ref": "#/$defs/trip_end" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Assigned once and never changed. Unique across the whole FILE.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "description": "Text for people to read. It holds no control character and no line or paragraph separator, and at least one character that is not a space. The pattern lists those characters one by one, so that every regular expression engine agrees. A reader also refuses half of a surrogate pair, which a pattern cannot state for every engine.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"
    },
    "time": {
      "description": "A date and time to the second, with its offset from UTC and the name of its time zone in brackets. This is a narrow form of RFC 9557. The offset must be the one that time zone has at that moment, by the release of the time-zone database that Agloe pins. The time lies in the years 0001 to 9999, on its own clock and in UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-]([01][0-9]|2[0-3]):[0-5][0-9]\\[[A-Za-z._][A-Za-z0-9._+-]*(/[A-Za-z._][A-Za-z0-9._+-]*)*\\]$"
    },
    "length": {
      "description": "A length of time in hours, minutes and seconds (ISO 8601), such as PT2H30M.",
      "type": "string",
      "pattern": "^PT(?=[0-9])([0-9]{1,9}H)?([0-9]{1,9}M)?([0-9]{1,9}S)?$"
    },
    "person": {
      "title": "Person",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "place": {
      "title": "Place",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "option_at_a_place": {
      "title": "OptionAtAPlace",
      "description": "An OPTION that happens at one PLACE.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "place"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "place": { "$ref": "#/$defs/id" }
      }
    },
    "option_between_places": {
      "title": "OptionBetweenPlaces",
      "description": "An OPTION that moves from one PLACE to another.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" }
      }
    },
    "way_one_way": {
      "title": "WayOneWay",
      "description": "A WAY from one PLACE to another. A PERSON can take it at any time, and as often as they need.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" }
      }
    },
    "way_both_ways": {
      "title": "WayBothWays",
      "description": "A WAY between two PLACEs, in both directions. A PERSON can take it at any time, and as often as they need.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "between"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "want": {
      "title": "Want",
      "description": "A WANT: something PERSONs want, or want to avoid, from the TRIP. It is about something an OPTION can deliver, or, with `itinerary`, about the whole ITINERARY. Each holder is a PERSON with their own DEGREE OF WANT, and a WANT names each PERSON at most once. A WANT about the whole ITINERARY is a must for each holder.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "holders"],
      "if": { "required": ["itinerary"] },
      "then": {
        "properties": {
          "holders": { "items": { "properties": { "degree": { "const": 10 } } } }
        }
      },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "itinerary": {
          "title": "Ending",
          "description": "What the WANT asks of the whole ITINERARY. `ends_at`: the holder ends the TRIP at this PLACE.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ends_at"],
          "properties": {
            "ends_at": { "$ref": "#/$defs/id" }
          }
        },
        "holders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Holder",
            "type": "object",
            "additionalProperties": false,
            "required": ["person", "degree"],
            "properties": {
              "person": { "$ref": "#/$defs/id" },
              "degree": {
                "description": "The DEGREE OF WANT. 10 makes the WANT a must for this PERSON, and -10 makes it a must-not.",
                "enum": [10, -10]
              }
            }
          }
        }
      }
    },
    "range": {
      "title": "Range",
      "type": "object",
      "additionalProperties": false,
      "required": ["shortest", "longest"],
      "properties": {
        "shortest": { "$ref": "#/$defs/length" },
        "longest": { "$ref": "#/$defs/length" }
      }
    },
    "fixed_start": {
      "title": "FixedStart",
      "description": "A FACT: the OPTION can start only at this time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "starts_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "starts_at": { "$ref": "#/$defs/time" }
      }
    },
    "free_start": {
      "title": "FreeStart",
      "description": "A FACT: the planners choose when the OPTION starts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "starts_any_time"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "starts_any_time": { "const": true }
      }
    },
    "exact_duration": {
      "title": "ExactDuration",
      "description": "A FACT: the OPTION takes exactly this long.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "duration": { "$ref": "#/$defs/length" }
      }
    },
    "contingent_duration": {
      "title": "ContingentDuration",
      "description": "A FACT: the world decides how long the OPTION takes, within this range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "contingent_duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "contingent_duration": { "$ref": "#/$defs/range" }
      }
    },
    "way_duration": {
      "title": "WayDuration",
      "description": "A FACT: the WAY takes exactly this long, each time a PERSON takes it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "way", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "way": { "$ref": "#/$defs/id" },
        "duration": { "$ref": "#/$defs/length" }
      }
    },
    "way_contingent_duration": {
      "title": "WayContingentDuration",
      "description": "A FACT: each time a PERSON takes the WAY, the world decides how long it takes, within this range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "way", "contingent_duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "way": { "$ref": "#/$defs/id" },
        "contingent_duration": { "$ref": "#/$defs/range" }
      }
    },
    "access_cutoff": {
      "title": "AccessCutoff",
      "description": "A FACT: each PERSON must reach the OPTION's PLACE at least this long before it starts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "arrive_before_start"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "arrive_before_start": { "$ref": "#/$defs/length" }
      }
    },
    "complete_set": {
      "title": "CompleteSet",
      "description": "A FACT: the FILE lists every OPTION and WAY that goes straight from one PLACE to another and starts within the stated span. Without `from` the FACT covers every PLACE of departure, and without `to` every PLACE of arrival.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "complete"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "complete": {
          "title": "Ways",
          "type": "object",
          "additionalProperties": false,
          "required": ["leaving"],
          "properties": {
            "from": { "$ref": "#/$defs/id" },
            "to": { "$ref": "#/$defs/id" },
            "leaving": {
              "title": "Span",
              "type": "object",
              "additionalProperties": false,
              "required": ["earliest", "latest"],
              "properties": {
                "earliest": { "$ref": "#/$defs/time" },
                "latest": { "$ref": "#/$defs/time" }
              }
            }
          }
        }
      }
    },
    "satisfies": {
      "title": "Satisfies",
      "description": "A FACT: how fully the OPTION delivers what a WANT describes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "satisfies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "satisfies": {
          "title": "Satisfaction",
          "type": "object",
          "additionalProperties": false,
          "required": ["want", "degree"],
          "properties": {
            "want": { "$ref": "#/$defs/id" },
            "degree": {
              "description": "The DEGREE OF SATISFACTION. Zero says that the OPTION does not deliver it. Any value above zero says that it does.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "complete_for_a_want": {
      "title": "CompleteForAWant",
      "description": "A FACT: the FILE states every OPTION that SATISFIES the WANT. Each one is listed, with a FACT that it SATISFIES the WANT. So an OPTION with no such FACT does not SATISFY it, and no OPTION outside the FILE does.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "complete"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "complete": {
          "title": "Satisfying",
          "type": "object",
          "additionalProperties": false,
          "required": ["satisfies"],
          "properties": {
            "satisfies": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "needs_right": {
      "title": "NeedsRight",
      "description": "A FACT: whether a PERSON needs a right, such as a ticket or a reservation, to take part in the OPTION.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "needs_right"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "option": { "$ref": "#/$defs/id" },
        "needs_right": { "type": "boolean" }
      }
    },
    "booking": {
      "title": "BookingFact",
      "description": "A FACT: a BOOKING. One agreement about one OPTION, for one unit that is used once. It secures a right to the OPTION for each PERSON it covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "booking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "booking": {
          "title": "Booking",
          "type": "object",
          "additionalProperties": false,
          "required": ["option", "covers"],
          "properties": {
            "option": { "$ref": "#/$defs/id" },
            "covers": {
              "description": "The PERSONs the BOOKING secures the right for.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "complete_rights": {
      "title": "CompleteRights",
      "description": "A FACT: the FILE holds every right to the OPTION. Nobody on the TRIP holds another, and no more can be had.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "complete"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "complete": {
          "title": "Rights",
          "type": "object",
          "additionalProperties": false,
          "required": ["rights_to"],
          "properties": {
            "rights_to": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "starts_from": {
      "title": "StartsFrom",
      "description": "A FACT: where a PERSON starts from. The PERSON's path begins at this PLACE.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "person", "starts_from"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "person": { "$ref": "#/$defs/id" },
        "starts_from": { "$ref": "#/$defs/id" }
      }
    },
    "trip_start": {
      "title": "TripStart",
      "description": "A DECISION: when the TRIP starts. Nothing in an ITINERARY starts before this time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trip_starts_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trip_starts_at": { "$ref": "#/$defs/time" }
      }
    },
    "trip_end": {
      "title": "TripEnd",
      "description": "A DECISION: when the TRIP ends. Nothing in an ITINERARY ends after this time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trip_ends_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trip_ends_at": { "$ref": "#/$defs/time" }
      }
    },
    "lock": {
      "title": "Lock",
      "description": "A LOCK: the TRIP includes this OPTION, and these PERSONs take part.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lock", "persons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lock": { "$ref": "#/$defs/id" },
        "persons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
